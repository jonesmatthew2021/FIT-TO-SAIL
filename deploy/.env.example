# Copy to deploy/.env on the box and fill in. `.env*` is gitignored (SEC-9) — this file, being
# `.example`, is the only one of the pair that is committed.

# Required. Used by both the database and the backend; no default, so a missing one fails the
# compose command rather than starting a database with a password somebody could guess.
#   openssl rand -base64 24
POSTGRES_PASSWORD=

# `synthetic` (invented crew, safe for any audience), `extracted` (the POC's workbook
# extracts — REAL crew names, Sam numbers and expiry dates) or `portal` (a snapshot of the
# Coolibah crew portal — also REAL crew data). Only read when the database is empty. See
# deploy/README.md before choosing either real one.
CREWCOMP_DEV_SEED_DATASET=synthetic

# Where the extracts live on the box, if the dataset above is `extracted`. Must be a directory
# holding seed/*.csv beside exceptions.csv. Left at the default it is an empty committed
# directory, which is correct for the synthetic dataset.
CREWCOMP_EXTRACT_ROOT=./extracts

# Where the portal snapshot lives on the box, if the dataset above is `portal`. Must be a
# directory holding portal-state.json (scripts/portal-snapshot.sh produces one on the Mac —
# copy its ~/coolibah-portal/latest/ here). Same empty-directory default as the extracts.
CREWCOMP_PORTAL_ROOT=./portal

# The roles an unheadered request is granted — i.e. what the back office runs as. Narrow this to
# one role to demonstrate that role's screens; never set it empty (the SPA would show a sign-in
# button pointing at a BFF the identity spike has not built).
CREWCOMP_DEV_AUTH_DEFAULT_ROLES=crew_coordinator,workflow_manager,compliance_lead,data_steward

# A reusable, UNTAGGED Tailscale auth key for the app's own tailnet node (Settings -> Keys in the
# admin console). Untagged because only users can accept a machine share, and this node exists to
# be shareable. After first start, disable key expiry for the `attest` device or it drops off the
# tailnet in 90 days and takes the share with it.
TS_AUTHKEY=
