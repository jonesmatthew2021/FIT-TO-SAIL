# Copy to deploy/.env on the box and fill in. `.env*` is gitignored (SEC-9) — this file, being
# `.example`, is the only one of the pair that is committed.
#
# EVERY key here must exist in .env. `attest` refuses to run until they all do, and `attest env
# --fix` appends the missing ones, because a key that is merely absent silently gets
# docker-compose's default instead — which is how real crew data came to be mounted from inside
# the repository for a fortnight (CREWCOMP_PORTAL_ROOT was never added, so `./portal` won).

# Required. Used by both the database and the backend; no default, so a missing one fails the
# compose command rather than starting a database with a password somebody could guess.
#   openssl rand -base64 24
POSTGRES_PASSWORD=

# `synthetic` (invented crew, safe for any audience), `extracted` (the POC's workbook
# extracts — REAL crew names, Sam numbers and expiry dates) or `portal` (a snapshot of the
# Coolibah crew portal — also REAL crew data). Only read when the database is empty. See
# deploy/README.md before choosing either real one.
CREWCOMP_DEV_SEED_DATASET=synthetic

# Where the extracts live on the box, if the dataset above is `extracted`. An ABSOLUTE path,
# outside this repository, to a directory holding seed/*.csv beside exceptions.csv — real crew
# data does not belong in a working tree, gitignored or not. `./extracts` is the committed empty
# directory, which is the right value only while the dataset is `synthetic`.
CREWCOMP_EXTRACT_ROOT=/home/chrisjones/attest-extracts

# Where the portal snapshot lives on the box, if the dataset above is `portal`. An ABSOLUTE path
# to a directory holding portal-state.json — normally the `latest` symlink that
# `attest snapshot` maintains, which this box now produces itself rather than taking from a Mac.
# `attest` resolves the symlink before mounting it, so the container is pinned to one revision.
CREWCOMP_PORTAL_ROOT=/home/chrisjones/coolibah-portal/latest

# The roles an unheadered request is granted — i.e. what the back office runs as. Narrow this to
# one role to demonstrate that role's screens; never set it empty (the SPA would show a sign-in
# button pointing at a BFF the identity spike has not built).
CREWCOMP_DEV_AUTH_DEFAULT_ROLES=crew_coordinator,workflow_manager,compliance_lead,data_steward

# A reusable, non-ephemeral, UNTAGGED Tailscale auth key for the app's own tailnet node
# (Settings -> Keys in the admin console). Untagged because only users can accept a machine share
# and sharing strips tags, so a tagged node cannot be shared at all. Non-ephemeral because an
# ephemeral node is DELETED from the tailnet shortly after it goes offline, which would lose the
# name and the share every time the stack stopped.
#
# It is read only when there is no ts-state volume to reuse — i.e. when rebuilding this box's
# identity from nothing, which is the worst moment to find the key lapsed. A reusable key's
# ceiling is 90 days, so record the date it was minted and `attest status` will warn before it
# matters.
TS_AUTHKEY=
TS_AUTHKEY_ISSUED=2026-08-26
