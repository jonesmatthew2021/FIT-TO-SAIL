# OS / editors
.DS_Store
*.swp
.idea/
.vscode/

# Secrets — never committed (SEC-9)
.env
.env.*
*.pem
*.p12
*.keystore
!*.example

# Build outputs (component-level gitignores refine these)
backend/build/
backend/.gradle/
backend/target/
admin-web/node_modules/
admin-web/dist/
mobile/build/
mobile/.dart_tool/

# OpenTofu / Terraform
**/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
.terraform.lock.hcl.backup

# Local scratch
scratch/
*.local.*

# The tailnet box's runtime state (deploy/): its environment file is covered by the .env rule
# above; these are the database dumps and, if the extracted dataset is in use, real crew data.
deploy/backups/
deploy/extracts/*
!deploy/extracts/.gitkeep
deploy/portal/*
!deploy/portal/.gitkeep

# Development stack runtime state (scripts/dev-start.sh): pidfiles, logs, generated MCP token
.dev/
